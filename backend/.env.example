# Copy to backend/.env (git-ignored). In production, put secrets in your secret store.
# Values are plain KEY=value; do not add inline comments after a value.

# Postgres 16 and Redis 7
SIMP_DATABASE_URL=postgresql+psycopg://simp:simp@127.0.0.1:5432/simp
SIMP_REDIS_URL=redis://127.0.0.1:6379/0

# Data: synthetic or live
SIMP_DATA_SOURCE=live

# Jobs: dramatiq (Redis workers) or inline (runs inside the API process; dev only)
SIMP_QUEUE=dramatiq

# Auth: dev (no login; everyone acts as an allow-listed user) or oauth (GitHub)
SIMP_AUTH_MODE=dev
SIMP_ALLOWED_USERS=tanish:researcher,andrew:viewer,admin:admin
SIMP_SESSION_SECRET=replace-with-a-long-random-string
SIMP_WEB_ORIGIN=http://localhost:3000
# SIMP_OAUTH_CLIENT_ID=
# SIMP_OAUTH_CLIENT_SECRET=

# Live data credentials
WRDS_USERNAME=
WRDS_PASSWORD=
# BMLL_KEY_PATH=/secure/path/to/bmll_ssh_private_key
