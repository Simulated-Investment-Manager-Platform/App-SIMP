# Copy to backend/.env. Secrets belong in the deployment secret store, never in git.
SIMP_DATABASE_URL=postgresql+psycopg://simp:simp@127.0.0.1:5432/simp
SIMP_REDIS_URL=redis://127.0.0.1:6379/0
SIMP_DATA_SOURCE=synthetic        # synthetic | live
SIMP_QUEUE=dramatiq               # dramatiq | inline
SIMP_AUTH_MODE=dev                # dev | oauth
SIMP_ALLOWED_USERS=tanish:researcher,andrew:viewer,admin:admin
SIMP_SESSION_SECRET=change-me
# SIMP_OAUTH_CLIENT_ID=
# SIMP_OAUTH_CLIENT_SECRET=
# WRDS_USERNAME=
# WRDS_PASSWORD=
# BMLL_KEY_PATH=/run/secrets/bmll_key
